# Foundry keystore account of the manifest deployer, used by deploy-chains.sh. Required unless UNLOCKED=1.
DEPLOYER_ACCOUNT=
# Etherscan V2 API key. Required when a chain selected in deploy-chains.sh uses the etherscan verifier.
ETHERSCAN_API_KEY=
# Optional deployment manifest for deploy-chains.sh (default deployments/v1.1.json).
MANIFEST=
# Optional chain registry for deploy-chains.sh (default chains.json).
CHAINS_FILE=
# Optional RPC override for one chain in deploy-chains.sh; the name is RPC_ plus the chain name from chains.json in upper case with '-' replaced by '_', e.g. RPC_SEPOLIA, RPC_ARC_TESTNET.
RPC_SEPOLIA=
# Optional; set to 1 to skip explorer verification in deploy-chains.sh.
NO_VERIFY=
# Optional; set to 1 to rehearse deploy-chains.sh against an anvil fork started with --auto-impersonate, sending as the deployer without a key.
UNLOCKED=
# Optional RPC endpoint for deploy.sh and generate-proxy.sh (default http://localhost:8545).
RPC_URL=
# Optional forge binary for deploy.sh (default forge).
FORGE_BIN=
# Optional cast binary for deploy.sh (default cast).
CAST_BIN=
# User address whose proxy address script/GenerateProxyAddress.s.sol computes. Required when running that script with forge directly; generate-proxy.sh ignores it and takes --user.
USER_ADDRESS=
# ProxyFactory address for script/GenerateProxyAddress.s.sol. Required when running that script with forge directly; generate-proxy.sh ignores it and takes --factory.
PROXY_FACTORY_ADDRESS=
# Private keys never go in this file. deploy.sh and generate-proxy.sh take --private-key; deploy-chains.sh uses the keystore in DEPLOYER_ACCOUNT.
